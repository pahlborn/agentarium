    {
      "regel": "R-22",
      "soll": "supersedes verweist von ART-11 v2 auf v1; die Vorgeschichte wird nicht geloescht."
    },
    {
      "regel": "R-11b",
      "soll": "Done verlangt einen versionsgebundenen Erfuellungsnachweis: outcome pass auf genau (artifact_id, version) VOR dem Statuswechsel, oder eine ausdruecklich autorisierte Abweichung. Befund B2."
    },
    {
      "regel": "R-28",
      "soll": "Die Revisionskette wird ueber die Ereignisfolge nachgerechnet: item_revision steigt je Aufgabe streng, previous_transition_id zeigt auf die vorige schreibende Transition, beim ersten Mal null. Befund B2."
    },
    {
      "regel": "R-21",
      "soll": "UMBENANNT und tatsaechlich geprueft: zwei Aufgaben haben sich SCHNEIDENDE Zeitfenster belegter Ereignisse. Das ist keine aktive Arbeitsdauer und keine Zusammenarbeit -- nur eine Ueberlappung belegter Zeitpunkte. In V2 wurden nur zwei task_ids gezaehlt; Befund B3."
    },
    {
      "regel": "R-29",
      "soll": "Der Referenz-Reducer rechnet zustand_am_cursor_soll aus den Ereignissen nach. Ein falsch behaupteter Zustand faellt damit auf. Befund B3."
    },
    {
      "regel": "R-36",
      "soll": "Der Done-Nachweis haengt an (task_id, artifact_id, version, criteria_ref). Ein Pass unter einer anderen Kriterienfassung oder fuer eine andere Aufgabe erlaubt Done NICHT. R2."
    },
    {
      "regel": "R-37",
      "soll": "Nur kind=status_change schreibt Status. W1 und W2 sind daher Statuswechsel, nicht Anfragen mit Zustandsfeldern. R1."
    }

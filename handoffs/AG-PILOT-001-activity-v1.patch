+<!DOCTYPE html>
+<html lang="de">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Agentarium – lokaler Aktivitätsmonitor / Teilanbindung</title>
+<style>
+  body { font-family: system-ui, sans-serif; margin: 1rem auto; max-width: 56rem; padding: 0 1rem; color: #1b1b1b; background: #fafafa; }
+  h1 { font-size: 1.3rem; }
+  .bar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; margin: .75rem 0; }
+  .notice { border-left: 4px solid #888; padding: .4rem .75rem; background: #eee; margin: .5rem 0; }
+  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: .75rem; }
+  .card { border: 2px solid #444; border-radius: .5rem; padding: .6rem .75rem; background: #fff; }
+  .card.unknown { border-style: dashed; border-color: #888; color: #444; }
+  .card.waiting { border-color: #2a5db0; }
+  .card.blocked { border-color: #b36b00; background: #fff6e5; }
+  .card.stopped { border-color: #333; }
+  .card.stopped.problem { border-color: #b00020; }
+  .card.working_observed { border-color: #1b7a3a; }
+  .card.pulse { animation: pulse 0.9s ease-out 1; }
+  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(27,122,58,.6); } 100% { box-shadow: 0 0 0 .8rem rgba(27,122,58,0); } }
+  @media (prefers-reduced-motion: reduce) { .card.pulse { animation: none; } }
+  .name { font-weight: 700; }
+  .state { font-weight: 600; }
+  .meta { font-size: .85rem; color: #444; word-break: break-word; }
+  .err { color: #b00020; }
+</style>
+</head>
+<body>
+<h1>Agentarium – lokaler Aktivitätsmonitor / Teilanbindung</h1>
+<div class="notice" id="coverage">Lade …</div>
+<div class="bar">
+  <button id="refresh" type="button">Aktualisieren</button>
+  <label><input type="checkbox" id="auto"> automatisch alle 2 s (lokal)</label>
+  <span id="transport">Monitorabruf: unbekannt</span>
+  <span id="mode"></span>
+</div>
+<div class="err" id="errors"></div>
+<div class="grid" id="grid"></div>
+<p class="notice" id="costs">Kosten nicht vollständig ermittelbar.</p>
+<script>
+(function () {
+  'use strict';
+  var params = new URLSearchParams(location.search);
+  var at = params.get('at');
+  var grid = document.getElementById('grid');
+  var seen = null; // key -> evidence stamp; null until first load (baseline, no pulse)
+  var timer = null;
+  var auto = document.getElementById('auto');
+  if (at) { auto.disabled = true; }
+
+  var LABELS = {
+    working_observed: ['▶', 'Arbeit beobachtet'],
+    waiting: ['⏸', 'Wartet (laut Quelle)'],
+    blocked: ['⚠', 'Blockiert (laut Quelle)'],
+    stopped: ['■', 'Beendet'],
+    unknown: ['?', 'Unbekannt']
+  };
+
+  function el(tag, cls, text) {
+    var e = document.createElement(tag);
+    if (cls) { e.className = cls; }
+    if (text !== undefined && text !== null) { e.textContent = String(text); }
+    return e;
+  }
+
+  function render(doc) {
+    var next = {};
+    var first = seen === null;
+    grid.textContent = '';
+    doc.rows.forEach(function (r) {
+      var known = Object.prototype.hasOwnProperty.call(LABELS, r.state);
+      var lab = known ? LABELS[r.state] : LABELS.unknown;
+      var key = r.agent + '|' + r.session_id + '|' + r.task_id;
+      var stamp = r.state === 'working_observed' ? (r.last_evidence_at + '|' + r.evidence_ref) : '';
+      next[key] = stamp;
+      var cls = 'card ' + (known ? r.state : 'unknown') + (r.problem ? ' problem' : '');
+      if (!first && !at && stamp && seen[key] !== stamp) { cls += ' pulse'; }
+      var c = el('div', cls);
+      c.appendChild(el('div', 'name', r.agent));
+      c.appendChild(el('div', 'state', lab[0] + ' ' + lab[1] +
+        (r.state === 'stopped' && r.outcome ? ' – ' + r.outcome : '') + (r.problem ? ' (Problem)' : '')));
+      c.appendChild(el('div', 'meta', 'Grund: ' + r.reason));
+      c.appendChild(el('div', 'meta', 'Letzter Nachweis: ' + (r.last_evidence_at || 'keiner') +
+        (r.evidence_ref ? ' (' + r.evidence_ref + ')' : '')));
+      c.appendChild(el('div', 'meta', 'Session: ' + (r.session_id || '–') + ' · Task: ' + (r.task_id || '–')));
+      (r.diagnostics || []).forEach(function (d) { c.appendChild(el('div', 'meta err', d)); });
+      grid.appendChild(c);
+    });
+    seen = next;
+    document.getElementById('coverage').textContent =
+      'Teilanbindung / nicht verbunden: ' + doc.coverage.note +
+      ' · Datenart: ' + (doc.data_kind || 'keine Quelle') +
+      ' · Frische-Schwelle: ' + (doc.configured_fresh_ms === null ? 'nicht gesetzt' : doc.configured_fresh_ms + ' ms') +
+      ' (' + doc.fresh_ms_note + ')';
+    document.getElementById('mode').textContent =
+      doc.mode === 'ARCHIVE' ? 'Archiv-Wiedergabe bei ' + doc.replay_at + ' (kein Auto-Fortschritt)' : 'LIVE ' + doc.now;
+    document.getElementById('errors').textContent = (doc.source_errors || []).join(' | ');
+    document.getElementById('costs').textContent = doc.kosten.status_text;
+    document.getElementById('transport').textContent = 'Monitorabruf erreichbar';
+  }
+
+  function load() {
+    var url = '/activity' + (at ? '?at=' + encodeURIComponent(at) : '');
+    fetch(url, { cache: 'no-store' }).then(function (res) {
+      return res.json().then(function (j) { return { ok: res.ok, j: j }; });
+    }).then(function (x) {
+      if (!x.ok) { throw new Error(x.j && x.j.error ? x.j.error : 'Fehler'); }
+      render(x.j);
+    }).catch(function (e) {
+      document.getElementById('transport').textContent = 'Monitorabruf nicht erreichbar';
+      document.getElementById('errors').textContent = String(e && e.message ? e.message : e);
+    });
+  }
+
+  document.getElementById('refresh').addEventListener('click', load);
+  auto.addEventListener('change', function () {
+    if (timer) { clearInterval(timer); timer = null; }
+    if (auto.checked && !at) { timer = setInterval(load, 2000); }
+  });
+  load();
+}());
+</script>
+</body>
+</html>

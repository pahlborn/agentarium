+    S.aktiv = false; S.transport = 'aus'; S.transportText = '';
+    S.doc = null; S.zeilen = []; S.marken = {}; S.puls = {}; S.quelle = null;
+    aufraeumen();
+  }
+  function starten() {
+    S.gen++; S.aktiv = true; S.transport = 'verbinde'; S.transportText = '';

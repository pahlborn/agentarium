+  /* ---------------------------------------------------------- Ansicht */
+  function wirksam(z, now) {
+    if (z.expireAt !== null && BEFRISTET[z.state] && now >= z.expireAt) {
+      var c = {}; for (var k in z) c[k] = z[k];
+      c.state = 'unknown'; c.expired = true;

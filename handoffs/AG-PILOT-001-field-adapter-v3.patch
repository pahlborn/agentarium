+      var z = neueZeile(r, t0), k = z.agent + '|' + z.session + '|' + z.task;
+      zeilen.push(z);
+      if (z.state === 'working_observed' && z.expireAt > t0) {
+        var tok = (z.evidenceAt || '') + '|' + (z.ref || '');
+        neu[k] = tok;
+        if (alt[k] !== tok) {              /* neuer Nachweis: ein Impuls, einmal */
+          S.puls[z.agent] = { nr: ++S.pulsNr, at: t0 };

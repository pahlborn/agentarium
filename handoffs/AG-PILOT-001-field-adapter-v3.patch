+      'left:50%;bottom:100%;transform:translateX(-50%);margin-bottom:.15em;' +
+      'font-size:.62em;letter-spacing:.04em;white-space:nowrap;pointer-events:none;' +
+      'font-weight:400;opacity:.9}' +
+      '.agName[data-akt=waiting]::after{opacity:.6}' +

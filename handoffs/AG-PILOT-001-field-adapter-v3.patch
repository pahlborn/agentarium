+                      signal: ctl ? ctl.signal : undefined })
+      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
+      .then(function (doc) { if (g === S.gen) annehmen(doc, t0); fertig(); })

+  function ansicht(now) {
+    now = (typeof now === 'number') ? now : jetzt();
+    var out = {};
+    S.zeilen.forEach(function (z) {
+      var w = wirksam(z, now), a = out[z.agent];
+      if (!a) a = out[z.agent] = { agent: z.agent, state: null, zeilen: [], anzahl: 0, outcome: null };

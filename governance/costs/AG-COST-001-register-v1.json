    },
    {
      "epic": "AG-VISUAL-004-EPIC",
      "version": 1,
      "story_id": "S3",
      "criterion_id": "AC12",
      "text": "AC12 IDs, provider, model and costs are hidden by default and can be switched on. Null actual values show as 'nicht vorhanden', never as 0. Synthetic costs always carry their label. The fiction label is always visible.",
      "source_ref": "specifications/AG-VISUAL-004-spec-v1.json",
      "addendum_ref": "specifications/AG-VISUAL-004-testability-v1.json",
      "associated_attempts": [

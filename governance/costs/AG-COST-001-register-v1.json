    },
    {
      "epic": "AG-VISUAL-004-EPIC",
      "version": 1,
      "story_id": "S2",
      "criterion_id": "AC09",
      "text": "AC09 Repair E17–E28: Forge changes the connection and Sentinel repeats the check. A permanent seam remains and the V1 state stays reachable through scrub or focus. Cadence (E21–E23) resolves the documented transition jam.",
      "source_ref": "specifications/AG-VISUAL-004-spec-v1.json",
      "addendum_ref": "specifications/AG-VISUAL-004-testability-v1.json",
      "associated_attempts": [
        "AG-VISUAL-004-ARCHIBALD",
        "AG-VISUAL-004-FORGE"
      ],
      "allocation": "Shared task cost, not individually separable"
    },
    {
      "epic": "AG-VISUAL-004-EPIC",
      "version": 1,
      "story_id": "S3",
      "criterion_id": "AC10",
      "text": "AC10 Argus review and Sentinel QA are visually distinct local acts. Only the agents involved react; there is no default whole-team meeting.",
      "source_ref": "specifications/AG-VISUAL-004-spec-v1.json",
      "addendum_ref": "specifications/AG-VISUAL-004-testability-v1.json",
      "associated_attempts": [
        "AG-VISUAL-004-ARCHIBALD",
